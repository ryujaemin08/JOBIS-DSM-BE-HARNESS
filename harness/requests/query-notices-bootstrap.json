{
  "name": "query-notices-bootstrap",
  "summary": "Query notice list",
  "method": "GET",
  "path": "/notices",
  "purpose": "Return the notice list for students and teachers with total count and snake_case timestamps.",
  "authority": ["STUDENT", "TEACHER"],
  "request": {
    "path_params": [],
    "query_params": [],
    "headers": [
      {
        "name": "Authorization",
        "type": "string",
        "required": true,
        "example": "Bearer {{steps.login_teacher.body.access_token}}"
      }
    ],
    "body": { "fields": [] }
  },
  "responses": {
    "success": {
      "status": 200,
      "body": {
        "total_count": 1,
        "notices": [
          {
            "id": 1,
            "title": "Bootstrap Notice",
            "created_at": "2026-03-01T09:00:00"
          }
        ]
      }
    },
    "failures": [
      { "case": "unauthorized", "status": 401 },
      { "case": "forbidden", "status": 403 }
    ]
  },
  "side_effects": [],
  "qa_expectations": {
    "success_assertions": [
      "The response contains total_count and notices[]."
    ],
    "negative_assertions": [
      "A request without a valid token returns 401."
    ]
  },
  "harness": {
    "bootstrap": {
      "mode": "prefer_api",
      "fallback_allowed": true,
      "steps": [
        {
          "id": "login_teacher",
          "request": {
            "method": "POST",
            "path": "/users/login",
            "headers": {
              "content-type": "application/json"
            },
            "body": {
              "account_id": "harness.teacher.01",
              "password": "HarnessPass123!",
              "platform_type": "WEB",
              "device_token": "harness-device-token"
            }
          },
          "expect": {
            "status": 200,
            "required_paths": ["access_token"]
          }
        },
        {
          "id": "create_notice",
          "request": {
            "method": "POST",
            "path": "/notices",
            "headers": {
              "Authorization": "Bearer {{steps.login_teacher.body.access_token}}",
              "content-type": "application/json"
            },
            "body": {
              "title": "Bootstrap Notice",
              "content": "Synthetic bootstrap notice",
              "attachments": []
            }
          },
          "expect": {
            "status": 201
          }
        }
      ]
    }
  }
}
