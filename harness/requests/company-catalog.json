{
  "name": "company-catalog",
  "summary": "Query company catalog",
  "method": "GET",
  "path": "/companies/catalog",
  "purpose": "Return a simple company catalog for teachers with optional name and type filters.",
  "authority": ["TEACHER"],
  "request": {
    "path_params": [],
    "query_params": [
      { "name": "name", "type": "string", "required": false, "example": "Harness Company" },
      { "name": "type", "type": "enum", "required": false, "example": "PARTICIPATING" }
    ],
    "headers": [
      { "name": "Authorization", "type": "string", "required": true, "example": "Bearer {{steps.login_teacher.body.access_token}}" }
    ],
    "body": { "fields": [] }
  },
  "responses": {
    "success": {
      "status": 200,
      "body": {
        "total_count": 1,
        "companies": [
          {
            "company_id": 20001,
            "name": "Harness Company",
            "type": "PARTICIPATING"
          }
        ]
      }
    },
    "failures": [
      { "case": "unauthorized", "status": 401 },
      { "case": "forbidden", "status": 403 }
    ]
  },
  "side_effects": [
    "Teacher can query seeded companies by name and type."
  ],
  "qa_expectations": {
    "success_assertions": [
      "The response contains total_count and companies[]."
    ],
    "negative_assertions": [
      "A request without a valid token returns 401."
    ]
  }
}
