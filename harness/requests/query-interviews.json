{
  "name": "query-interviews",
  "summary": "Query all interview schedules",
  "method": "GET",
  "path": "/interviews",
  "purpose": "Return interview schedules with optional year, month, interview type, and company filters.",
  "authority": ["TEACHER", "STUDENT"],
  "request": {
    "path_params": [],
    "query_params": [
      {
        "name": "year",
        "type": "int",
        "required": false,
        "example": 2026
      },
      {
        "name": "month",
        "type": "int",
        "required": false,
        "example": 3
      },
      {
        "name": "interview_type",
        "type": "enum",
        "required": false,
        "example": "FINAL_INTERVIEW"
      },
      {
        "name": "company_name",
        "type": "string",
        "required": false,
        "example": "HarnessCompanyAlpha"
      }
    ],
    "headers": [
      {
        "name": "Authorization",
        "type": "string",
        "required": true,
        "example": "Bearer {{steps.login_teacher.body.access_token}}"
      }
    ],
    "body": {
      "fields": []
    }
  },
  "responses": {
    "success": {
      "status": 200,
      "body": {
        "total_count": 1,
        "interviews": [
          {
            "id": 11001,
            "interview_type": "FINAL_INTERVIEW",
            "start_date": "2026-03-15",
            "end_date": "2026-03-15",
            "interview_time": "14:00",
            "company_name": "HarnessCompanyAlpha",
            "location": "Seoul Gangnam-gu",
            "document_number_id": 10011
          }
        ]
      }
    },
    "failures": [
      { "case": "unauthorized", "status": 401 },
      { "case": "forbidden", "status": 403 },
      { "case": "invalid_month_without_year", "status": 400 }
    ]
  },
  "side_effects": [
    "Student sees only their own interviews.",
    "Teacher can see interviews for multiple students.",
    "Year and month filters should match the seeded interview dates."
  ],
  "qa_expectations": {
    "success_assertions": [
      "The response contains total_count and interviews[].",
      "At least one interview matches the provided year, month, type, and company filters."
    ],
    "negative_assertions": [
      "A request without a valid token returns 401."
    ]
  }
}
