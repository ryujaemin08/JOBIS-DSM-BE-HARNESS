{
  "name": "update-interview-date",
  "summary": "Update interview date API",
  "method": "PATCH",
  "path": "/interviews/{interview-id}/date",
  "purpose": "Update the scheduled date for an existing interview.",
  "authority": ["TEACHER"],
  "request": {
    "path_params": [
      {
        "name": "interview-id",
        "type": "long",
        "required": true,
        "example": 11001
      }
    ],
    "query_params": [],
    "headers": [],
    "body": {
      "fields": [
        {
          "name": "interview_date",
          "type": "datetime",
          "required": true,
          "example": "2026-05-01"
        }
      ]
    }
  },
  "responses": {
    "success": {
      "status": 204,
      "body": null
    },
    "failures": [
      { "case": "not_found", "status": 404 },
      { "case": "unauthorized", "status": 403 },
      { "case": "invalid_date", "status": 400 }
    ]
  },
  "side_effects": [
    "The target interview row is updated with the requested interview_date.",
    "A follow-up read should return the updated date."
  ],
  "qa_expectations": {
    "success_assertions": [
      "The update request returns 204."
    ],
    "negative_assertions": [
      "A caller without authority receives 403."
    ]
  },
  "harness": {
    "seed": {
      "dataset_scale": 8
    },
    "bootstrap": {
      "mode": "prefer_api",
      "fallback_allowed": true,
      "steps": []
    }
  }
}
