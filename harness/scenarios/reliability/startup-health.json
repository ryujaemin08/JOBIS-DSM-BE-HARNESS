{
  "name": "startup-health",
  "kind": "sre",
  "base_url": "http://localhost:18080",
  "probes": [
    {
      "id": "health",
      "type": "http_json",
      "request": {
        "method": "GET",
        "path": "/actuator/health"
      },
      "expect": {
        "status": 200,
        "equals": {
          "status": "UP"
        }
      }
    },
    {
      "id": "metrics-index",
      "type": "http_json",
      "request": {
        "method": "GET",
        "path": "/actuator/metrics"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "id": "prometheus-scrape",
      "type": "http_text",
      "request": {
        "method": "GET",
        "path": "/actuator/prometheus"
      },
      "expect": {
        "status": 200,
        "contains": ["jvm_"]
      }
    },
    {
      "id": "student-recruitments-latency",
      "type": "http_latency",
      "setup_steps": [
        {
          "id": "login",
          "request": {
            "method": "POST",
            "path": "/users/login",
            "headers": {
              "content-type": "application/json"
            },
            "body": {
              "account_id": "harness.student.01",
              "password": "HarnessPass123!",
              "platform_type": "WEB",
              "device_token": "harness-device-token"
            }
          },
          "expect": {
            "status": 200,
            "required_paths": ["access_token"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "path": "/recruitments/student",
        "headers": {
          "Authorization": "Bearer {{steps.login.body.access_token}}"
        }
      },
      "samples": 5,
      "expect": {
        "status": 200,
        "p95_ms_lte": 400
      }
    },
    {
      "id": "logs",
      "type": "logs_post_startup",
      "expect": {
        "max_matches": 0
      }
    }
  ]
}
